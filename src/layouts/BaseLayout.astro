---
/**
 * BaseLayout.astro — root document shell. Pages provide their own <h1>
 * and, if needed, extra <head> content via the `head` slot (e.g. a
 * dedicated Seo.astro component). `lang` defaults to the current i18n
 * locale (Astro.currentLocale) rather than being hardcoded.
 *
 * <ClientRouter /> turns same-origin navigations (ES ↔ EN, privacy page)
 * into in-place swaps so RouteLoader can show a frosted skeleton instead
 * of a blank reload. Consequence for every component script: bundled
 * <script>s run ONCE per session, not once per page — per-page setup must
 * hang off `astro:page-load` (or use document-level event delegation).
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import RouteLoader from '../components/molecules/RouteLoader.astro';
import { useTranslations } from '../lib/i18n';

interface Props {
  lang?: string;
}

const { lang = Astro.currentLocale ?? 'es' } = Astro.props;
const htmlLang = lang === 'en' ? 'en-US' : lang === 'es' ? 'es-CO' : lang;
const loadingLabel = useTranslations(lang === 'en' ? 'en' : 'es')('loading.page');
---

<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/app-icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/app-icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/app-icon-180.png" />
    <script is:inline>
      // Blocking, pre-paint theme init — avoids a flash of the wrong
      // theme. Paper (light) is the default; only an explicit choice
      // stored by the toggle switches to dark.
      (function () {
        try {
          document.documentElement.dataset.theme = localStorage.getItem('biw-theme') === 'dark' ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
        // Arms the scroll-reveal styles (global.css). Without JS nothing
        // is ever hidden.
        document.documentElement.dataset.js = '';
      })();
    </script>
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body>
    <RouteLoader label={loadingLabel} />
    <slot />
  </body>
</html>

<script>
  // Scroll reveal: `[data-reveal]` gets `.is-in` the first time it enters
  // the viewport (CSS in global.css does the rest). `[data-count]` inside
  // a revealed block counts up to its value. Re-binds on every
  // `astro:page-load` (ClientRouter) and tears down the previous run.
  let observer: IntersectionObserver | null = null;

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count);
    const suffix = el.dataset.suffix ?? '';
    if (!Number.isFinite(target)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = `${target}${suffix}`;
      return;
    }
    const delay = Number(el.dataset.delay ?? 350);
    const duration = 1100;
    el.textContent = `0${suffix}`;
    setTimeout(() => {
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, delay);
  }

  function reveal(el: Element) {
    el.classList.add('is-in');
    el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
  }

  document.addEventListener('astro:page-load', () => {
    observer?.disconnect();
    const targets = document.querySelectorAll('[data-reveal]:not(.is-in)');
    if (!('IntersectionObserver' in window)) {
      targets.forEach(reveal);
      return;
    }
    observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target);
          obs.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    targets.forEach((el) => observer!.observe(el));
  });
</script>

<script>
  // Cursor light for `[data-spotlight]` documents — one delegated listener
  // for the whole session (survives ClientRouter swaps).
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;
    document.addEventListener(
      'pointermove',
      (event) => {
        const host = (event.target as Element | null)?.closest<HTMLElement>('[data-spotlight]');
        if (!host) return;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = host.getBoundingClientRect();
          host.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          host.style.setProperty('--my', `${event.clientY - rect.top}px`);
        });
      },
      { passive: true },
    );
  }
</script>
