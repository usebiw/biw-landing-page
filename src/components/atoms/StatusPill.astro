---
/**
 * StatusPill.astro — tone drives the semantic color.
 * `warning`/`blocked` (signal orange) are RESERVED for the budget instrument's
 * 80%/110% execution gates — never use them for a generic "beta" or
 * "coming soon" label. Use `info`/`neutral` for anything that isn't a
 * budget-threshold reading.
 */
interface Props {
  tone: 'ok' | 'info' | 'neutral' | 'warning' | 'blocked';
  class?: string;
}

const { tone, class: className = '' } = Astro.props;

const tones: Record<string, string> = {
  ok: 'bg-biw-500/15 text-biw-400 border-biw-500/30',
  info: 'bg-[var(--surface-card-strong)] text-[var(--text-primary)] border-[var(--border-hairline-strong)]',
  neutral: 'bg-[var(--surface-card)] text-[var(--text-secondary)] border-[var(--border-hairline)]',
  warning: 'bg-signal-500/15 text-signal-500 border-signal-500/30',
  blocked: 'bg-signal-500/20 text-signal-500 border-signal-500/40',
};
---

<span
  class={[
    'inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em]',
    tones[tone],
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  <span class="size-1.5 rounded-full bg-current"></span>
  <slot />
</span>
