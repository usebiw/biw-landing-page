---
/**
 * Icon.astro
 * Self-authored SVG icon set, single consistent stroke (stroke-width 1.5),
 * no external icon library, NEVER emoji/unicode glyphs.
 */
export type IconName =
  | 'check'
  | 'chart'
  | 'shield'
  | 'clock'
  | 'users'
  | 'wallet'
  | 'camera'
  | 'alert'
  | 'lock'
  | 'arrow-right'
  | 'whatsapp'
  | 'chevron-down'
  | 'building'
  | 'layers'
  | 'file-text'
  | 'calendar'
  | 'trending-up'
  | 'eye'
  | 'bell'
  | 'settings'
  | 'map-pin'
  | 'message-circle'
  | 'sun'
  | 'moon'
  | 'globe';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

