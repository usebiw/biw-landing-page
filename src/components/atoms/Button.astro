---
/**
 * Button.astro
 * Renders <a> when `href` is passed, otherwise a native <button>.
 * Focus ring always visible (inherits :focus-visible from global.css).
 * Carries `group` so a trailing icon can react to hover.
 *
 * - primary: solid logo blue, square-ish corners, light sweep on hover
 * - secondary: ink outline on the paper ground
 */
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', size = 'md', href, type = 'button', class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
  md: 'h-10 px-4 text-sm',
  lg: 'h-12 px-6 text-[0.9375rem]',
};

const variants: Record<string, string> = {
  primary: 'btn-sheen bg-accent text-white hover:bg-biw-600',
  secondary: 'border border-ink/25 text-ink hover:border-ink hover:bg-sheet',
};

const base =
  'group inline-flex items-center justify-center gap-2 rounded-[3px] font-sans font-semibold transition-colors duration-150 disabled:pointer-events-none disabled:opacity-50';

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
