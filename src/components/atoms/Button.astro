---
/**
 * Button.astro
 * Renders <a> when `href` is passed, otherwise a native <button>.
 * Focus ring always visible (inherits :focus-visible from global.css).
 * Carries `group` so a trailing icon can react to hover
 * (`group-hover:translate-x-1`).
 *
 * - primary: solid electric blue with a sheen that sweeps across on hover
 * - glass: frosted pane (for use over the hero atmosphere)
 * - ghost / outline: quiet secondary actions
 */
interface Props {
  variant?: 'primary' | 'ghost' | 'outline' | 'glass';
  size?: 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', size = 'md', href, type = 'button', class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const variants: Record<string, string> = {
  primary:
    'btn-sheen relative overflow-hidden bg-biw-500 text-white hover:bg-biw-600 shadow-[0_20px_45px_-18px_rgba(20,80,255,0.75),inset_0_1px_0_rgba(255,255,255,0.25)] hover:shadow-[0_24px_55px_-16px_rgba(20,80,255,0.9),inset_0_1px_0_rgba(255,255,255,0.25)]',
  ghost:
    'bg-transparent text-[var(--text-primary)] hover:bg-[var(--surface-card-strong)] border border-[var(--border-hairline)]',
  outline: 'bg-transparent text-[var(--text-primary)] border border-biw-400 hover:bg-biw-500/10',
  glass:
    'border border-[var(--glass-border)] bg-[var(--glass-bg)] text-[var(--text-primary)] backdrop-blur-2xl backdrop-saturate-150 shadow-[inset_0_1px_0_var(--glass-highlight)] hover:border-biw-400/70 hover:bg-[var(--glass-bg-strong)]',
};

const base =
  'group inline-flex items-center justify-center gap-2 rounded-lg font-sans font-semibold tracking-tight transition-[background-color,box-shadow,border-color,color] duration-300 disabled:opacity-50 disabled:pointer-events-none';

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}

<style is:global>
  .btn-sheen::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.28) 50%, transparent 70%);
    translate: -120% 0;
    transition: translate 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .btn-sheen:hover::before {
    translate: 120% 0;
  }
</style>
