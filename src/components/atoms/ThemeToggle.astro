---
/**
 * ThemeToggle.astro — light/dark switch. The actual theme is applied by a
 * blocking inline script in BaseLayout (before paint, no flash); this
 * component only renders the button and wires the click handler. May be
 * rendered more than once per page (desktop + mobile nav), so it's
 * selected by `data-theme-toggle`, never by id, and every instance stays
 * in sync. State persists in localStorage under `biw-theme`.
 */
interface Props {
  labelLight: string;
  labelDark: string;
  class?: string;
}

const { labelLight, labelDark, class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-label-light={labelLight}
  data-label-dark={labelDark}
  aria-label={labelDark}
  class={[
    'inline-flex size-10 shrink-0 items-center justify-center rounded-lg border border-[var(--border-hairline)] text-[var(--text-primary)] transition-colors hover:bg-[var(--surface-card-strong)]',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  <svg
    class="size-[18px] [html[data-theme=light]_&]:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 4v2M12 18v2M4 12h2M18 12h2M6.3 6.3l1.4 1.4M16.3 16.3l1.4 1.4M6.3 17.7l1.4-1.4M16.3 7.7l1.4-1.4M12 8a4 4 0 100 8 4 4 0 000-8z" />
  </svg>
  <svg
    class="hidden size-[18px] [html[data-theme=light]_&]:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 12.5A8.5 8.5 0 1111.5 4a7 7 0 108.5 8.5z" />
  </svg>
</button>

<script>
  // Runs once per session (ClientRouter): the click handler is delegated
  // on document so it keeps working on swapped-in pages, and labels are
  // re-synced on every `astro:page-load`.
  const KEY = 'biw-theme';
  type Theme = 'light' | 'dark';

  function current(): Theme {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function apply(theme: Theme) {
    const root = document.documentElement;
    root.dataset.theme = theme;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      meta.setAttribute('content', getComputedStyle(root).getPropertyValue('--theme-color-meta').trim());
    }
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', theme === 'light' ? (btn.dataset.labelDark ?? '') : (btn.dataset.labelLight ?? ''));
    });
  }

  function switchTheme(origin: HTMLElement) {
    const next: Theme = current() === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* private mode — the switch still applies for this session */
    }

    const root = document.documentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduced) {
      apply(next);
      return;
    }

    // Circular reveal of the new theme, growing out of the toggle itself.
    const rect = origin.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    root.dataset.vt = 'theme';
    const transition = document.startViewTransition(() => apply(next));
    transition.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 700, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      })
      .catch(() => {});
    transition.finished.finally(() => delete root.dataset.vt);
  }

  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-theme-toggle]');
    if (btn) switchTheme(btn);
  });

  document.addEventListener('astro:page-load', () => apply(current()));
</script>
