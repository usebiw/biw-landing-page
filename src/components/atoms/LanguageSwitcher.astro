---
/**
 * LanguageSwitcher.astro — ES/EN links to the same page in the other
 * locale (Astro's i18n routing: /es/... <-> /en/...). Plain links, so it
 * works without JS; with the ClientRouter they swap in place behind
 * RouteLoader's frosted skeleton and keep the scroll depth
 * (`data-locale-switch`). Prefetched on hover so the wait stays short.
 */
import { locales, localeMeta, getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  currentLocale: Locale;
  ariaLabel: string;
  class?: string;
}

const { currentLocale, ariaLabel, class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
---

<div
  role="group"
  aria-label={ariaLabel}
  class={[
    'relative inline-flex items-center gap-0.5 rounded-full border border-[var(--border-hairline)] bg-[var(--surface-card)] p-1',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  {locales.map((locale) => (
    <a
      href={getLocalizedPath(pathname, locale)}
      hreflang={localeMeta[locale].htmlLang}
      lang={localeMeta[locale].htmlLang}
      data-locale-switch
      data-astro-prefetch="hover"
      aria-current={locale === currentLocale ? 'true' : undefined}
      class:list={[
        'relative rounded-full px-2.5 py-1 font-sans text-xs font-semibold uppercase tracking-[0.08em] transition-colors duration-200',
        locale === currentLocale
          ? 'bg-biw-500 text-white shadow-[0_6px_18px_-6px_rgba(20,80,255,0.9)]'
          : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
      ]}
    >
      {localeMeta[locale].label}
    </a>
  ))}
</div>
