---
/**
 * LanguageSwitcher.astro — ES/EN links to the same page in the other
 * locale (Astro's i18n routing: /es/... <-> /en/...). Plain links, so it
 * works without JS; with the ClientRouter they swap in place behind
 * RouteLoader and keep the scroll depth (`data-locale-switch`).
 * Prefetched on hover so the wait stays short.
 */
import { locales, localeMeta, getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  currentLocale: Locale;
  ariaLabel: string;
  class?: string;
}

const { currentLocale, ariaLabel, class: className = '' } = Astro.props;
const pathname = Astro.url.pathname;
---

<div role="group" aria-label={ariaLabel} class={['inline-flex items-center text-xs font-semibold', className].filter(Boolean).join(' ')}>
  {locales.map((locale, i) => (
    <>
      {i > 0 && <span class="px-1.5 text-ink-3" aria-hidden="true">/</span>}
      <a
        href={getLocalizedPath(pathname, locale)}
        hreflang={localeMeta[locale].htmlLang}
        lang={localeMeta[locale].htmlLang}
        data-locale-switch
        data-astro-prefetch="hover"
        aria-current={locale === currentLocale ? 'true' : undefined}
        class:list={[
          'py-1 transition-colors duration-150',
          locale === currentLocale ? 'text-ink underline decoration-accent decoration-2 underline-offset-4' : 'text-ink-3 hover:text-ink',
        ]}
      >
        {localeMeta[locale].label}
      </a>
    </>
  ))}
</div>
