---
/**
 * Textarea.astro — labeled textarea, same error/focus contract as Input.
 */
interface Props {
  label: string;
  name: string;
  required?: boolean;
  error?: string;
  placeholder?: string;
  class?: string;
}

const { label, name, required = false, error, placeholder, class: className = '' } = Astro.props;

const inputId = `textarea-${name}`;
const errorId = `${inputId}-error`;
---

<div class={['flex flex-col gap-1.5', className].filter(Boolean).join(' ')}>
  <label for={inputId} class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-[var(--text-secondary)]">
    {label}{required && <span class="text-signal-500"> *</span>}
  </label>
  <textarea
    id={inputId}
    name={name}
    rows="4"
    placeholder={placeholder}
    required={required}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={error ? errorId : undefined}
    class:list={[
      'resize-y rounded-lg border bg-[var(--surface-card)] px-3.5 py-2.5 font-sans text-sm text-[var(--text-primary)] placeholder:text-[var(--text-secondary)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-biw-400',
      error ? 'border-signal-500' : 'border-[var(--border-hairline)] focus:border-biw-400',
    ]}
  ></textarea>
  {error && (
    <p id={errorId} class="font-sans text-xs text-signal-500">
      {error}
    </p>
  )}
</div>
