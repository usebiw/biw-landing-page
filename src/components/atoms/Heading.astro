---
/**
 * Heading.astro — renders <h{level}> in font-display (Archivo, semi-
 * expanded). `size` controls the type scale independently of semantic
 * level. Solid ink only — no gradient text.
 */
interface Props {
  level: 1 | 2 | 3 | 4;
  size: 'xl' | 'lg' | 'md';
  class?: string;
}

const { level, size, class: className = '' } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';

const sizes: Record<string, string> = {
  xl: 'text-[2.25rem] md:text-[3rem]',
  lg: 'text-2xl md:text-3xl',
  md: 'text-xl md:text-2xl',
};

const classes = ['text-ink', sizes[size], className].filter(Boolean).join(' ');
---

<Tag class={classes}><slot /></Tag>
