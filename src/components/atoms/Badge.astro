---
/**
 * Badge.astro — small uppercase tracked label. Slot = text.
 */
interface Props {
  tone?: 'blue' | 'orange' | 'neutral';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones: Record<string, string> = {
  blue: 'bg-biw-500/15 text-biw-400 border-biw-500/30',
  orange: 'bg-signal-500/15 text-signal-500 border-signal-500/30',
  neutral: 'bg-[var(--surface-card-strong)] text-[var(--text-primary)] border-[var(--border-hairline)]',
};

const classes = [
  'inline-flex items-center rounded-lg border px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.08em]',
  tones[tone],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<span class={classes}><slot /></span>
