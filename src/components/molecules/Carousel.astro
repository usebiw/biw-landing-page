---
/**
 * Carousel.astro — generic horizontal scroll-snap carousel shell. Slot =
 * one direct child per slide (the caller sizes its own slides — this
 * component only owns the track/controls mechanics). Native scroll-snap
 * does the heavy lifting (touch swipe, momentum); the script only wires
 * arrows, segment indicators, arrow keys, and marks the slide in focus
 * with `data-active` so it can be lit up (the others recede slightly).
 *
 * Multiple instances per page are supported (everything is scoped via
 * the `[data-carousel]` root, never a page-wide id), and setup runs on
 * every `astro:page-load` because the ClientRouter swaps pages in place.
 */
interface Props {
  ariaLabel: string;
  prevLabel: string;
  nextLabel: string;
  class?: string;
}

const { ariaLabel, prevLabel, nextLabel, class: className = '' } = Astro.props;
---

<div
  class={['carousel', className].filter(Boolean).join(' ')}
  data-carousel
  role="region"
  aria-roledescription="carousel"
  aria-label={ariaLabel}
  tabindex="0"
>
  <div class="carousel-viewport">
    <div class="carousel-track" data-track>
      <slot />
    </div>
  </div>

  <div class="carousel-controls">
    <button type="button" class="carousel-arrow" data-prev aria-label={prevLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <div class="carousel-dots" data-dots></div>
    <button type="button" class="carousel-arrow" data-next aria-label={nextLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .carousel {
    outline: none;
  }

  .carousel:focus-visible {
    outline: 2px solid var(--color-biw-400);
    outline-offset: 8px;
    border-radius: 1rem;
  }

  .carousel-viewport {
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    margin-inline: -1.5rem;
    /* vertical room so hover-lift + glow shadows aren't clipped */
    padding: 1.5rem 1.5rem 3rem;
    margin-block: -1.5rem -3rem;
    scroll-padding-inline: 1.5rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 4rem), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 4rem), transparent);
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    display: flex;
    gap: 1.25rem;
  }

  .carousel-track > :global(*) {
    scroll-snap-align: start;
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Once the script has run, slides not in focus recede a little. */
  .carousel[data-ready] .carousel-track > :global(:not([data-active])) {
    opacity: 0.62;
    filter: saturate(0.7);
  }

  .carousel[data-ready] .carousel-track > :global(*:hover) {
    opacity: 1;
    filter: none;
  }

  .carousel-controls {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
    background: var(--glass-bg);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.3s ease,
      opacity 0.2s ease;
  }

  .carousel-arrow svg {
    width: 18px;
    height: 18px;
  }

  .carousel-arrow:hover {
    border-color: var(--color-biw-400);
    box-shadow: 0 10px 30px -10px rgb(20 80 255 / 0.7);
  }

  .carousel-arrow:disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .carousel-dots :global(button) {
    position: relative;
    width: 1.5rem;
    height: 1.25rem;
    border-radius: 9999px;
  }

  .carousel-dots :global(button)::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 3px;
    translate: 0 -50%;
    border-radius: 9999px;
    background: var(--border-hairline-strong);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .carousel-dots :global(button[aria-current='true']) {
    width: 3rem;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carousel-dots :global(button[aria-current='true'])::after {
    background: linear-gradient(90deg, var(--color-biw-600), var(--color-biw-400));
    box-shadow: 0 0 12px rgb(77 123 255 / 0.8);
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel-viewport {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  function initCarousel(root: HTMLElement, signal: AbortSignal) {
    const viewport = root.querySelector<HTMLElement>('.carousel-viewport');
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-dots]');
    if (!viewport || !track || !prevBtn || !nextBtn || !dotsWrap) return;

    // Re-bind to non-null names: TS narrowing above doesn't survive into
    // the closures declared below (updateControls, event listeners).
    const vp = viewport;
    const prev = prevBtn;
    const next = nextBtn;
    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length === 0) return;

    dotsWrap.innerHTML = '';
    const dots = slides.map((slide, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `${i + 1} / ${slides.length}`);
      dot.addEventListener('click', () => goTo(i), { signal });
      dotsWrap.appendChild(dot);
      return dot;
    });

    function goTo(index: number) {
      const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
      // The first slide sits at scrollLeft 0, so each slide's offset from
      // it is exactly the scroll position that snaps it to the start.
      vp.scrollTo({ left: target.offsetLeft - slides[0].offsetLeft });
    }

    let activeIndex = 0;
    function updateControls() {
      const max = vp.scrollWidth - vp.clientWidth - 2;
      prev.disabled = vp.scrollLeft <= 2;
      next.disabled = vp.scrollLeft >= max;

      const origin = slides[0].offsetLeft;
      let closest = 0;
      let closestDist = Infinity;
      slides.forEach((slide, i) => {
        const dist = Math.abs(slide.offsetLeft - origin - vp.scrollLeft);
        if (dist < closestDist) {
          closestDist = dist;
          closest = i;
        }
      });
      // At the end of the track the last slide can't snap to the start —
      // treat "scrolled to the end" as the last slide being in focus.
      if (vp.scrollLeft >= max && slides.length > 1) closest = slides.length - 1;
      activeIndex = closest;

      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === closest)));
      slides.forEach((slide, i) => {
        if (i === closest) slide.setAttribute('data-active', '');
        else slide.removeAttribute('data-active');
      });
    }

    prev.addEventListener('click', () => goTo(activeIndex - 1), { signal });
    next.addEventListener('click', () => goTo(activeIndex + 1), { signal });

    root.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goTo(activeIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goTo(activeIndex + 1);
        }
      },
      { signal },
    );

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateControls);
    };
    vp.addEventListener('scroll', schedule, { passive: true, signal });
    window.addEventListener('resize', schedule, { signal });
    updateControls();
    root.setAttribute('data-ready', '');
  }

  let controller: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => initCarousel(root, signal));
  });
</script>
