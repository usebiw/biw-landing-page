---
/**
 * Atmosphere.astro — the ground the glass refracts: slow-drifting blue
 * mesh blobs (heavy 90px blur), a masked dot grid, and film grain. Place
 * as the first child of a `relative overflow-hidden` section. Purely
 * decorative (aria-hidden), animation stops under reduced motion.
 *
 * `variant` only moves the blobs so consecutive sections don't mirror
 * each other; colors come from theme tokens (--mesh-a/b/c).
 */
interface Props {
  variant?: 'hero' | 'left' | 'right' | 'center';
  grid?: boolean;
  class?: string;
}

const { variant = 'hero', grid = true, class: className = '' } = Astro.props;

const layouts = {
  hero: [
    'size-[46rem] -top-48 -right-40 bg-[var(--mesh-a)]',
    'size-[34rem] top-1/3 -left-48 bg-[var(--mesh-b)] [animation-delay:-14s] [animation-duration:48s]',
    'size-[26rem] -bottom-24 left-1/2 bg-[var(--mesh-c)] [animation-delay:-26s] [animation-duration:58s]',
  ],
  left: [
    'size-[36rem] top-0 -left-56 bg-[var(--mesh-a)]',
    'size-[24rem] bottom-0 left-1/3 bg-[var(--mesh-c)] [animation-delay:-20s] [animation-duration:52s]',
  ],
  right: [
    'size-[36rem] top-10 -right-56 bg-[var(--mesh-a)]',
    'size-[24rem] -bottom-20 right-1/3 bg-[var(--mesh-b)] [animation-delay:-18s] [animation-duration:50s]',
  ],
  center: [
    'size-[40rem] top-1/4 left-1/2 -translate-x-1/2 bg-[var(--mesh-a)]',
    'size-[22rem] bottom-0 -left-20 bg-[var(--mesh-b)] [animation-delay:-22s] [animation-duration:54s]',
  ],
} as const;
---

<div class={['atmosphere', className].filter(Boolean).join(' ')} aria-hidden="true">
  {layouts[variant].map((cls) => <div class={`mesh-blob ${cls}`}></div>)}
  {grid && <div class="dot-grid"></div>}
  <div class="grain"></div>
</div>
