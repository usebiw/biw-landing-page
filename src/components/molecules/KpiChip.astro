---
/**
 * KpiChip.astro — one of the 3 hero stat chips (Obras en tiempo real ·
 * Mayor eficiencia · Decisiones inteligentes). Pair with `Divider dot`
 * between chips at the call site.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<span
  class={[
    'font-sans text-xs font-semibold uppercase tracking-[0.1em] text-[var(--text-secondary)]',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  {label}
</span>
