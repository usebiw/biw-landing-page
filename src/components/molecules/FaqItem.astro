---
/**
 * FaqItem.astro — native <details>/<summary> accordion entry.
 * itemScope/itemProp left available for FAQPage microdata, but JSON-LD
 * on the page already covers structured data — do not duplicate both.
 */
interface Props {
  question: string;
  answer: string;
  id: string;
  class?: string;
}

const { question, answer, id, class: className = '' } = Astro.props;
---

<details id={id} class={['group py-5', className].filter(Boolean).join(' ')}>
  <summary
    class="-mx-3 flex cursor-pointer list-none items-center justify-between gap-6 rounded-lg px-3 py-0.5 font-display text-base font-bold tracking-tight text-[var(--text-primary)] transition-colors [&::-webkit-details-marker]:hidden hover:bg-[var(--surface-card)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-biw-400 md:text-lg"
  >
    <span>{question}</span>
    <svg
      class="size-4 shrink-0 text-biw-400 transition-transform duration-200 group-open:rotate-180"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </summary>
  <p class="mt-3 max-w-[70ch] font-sans text-sm text-[var(--text-secondary)]">{answer}</p>
</details>
