---
/**
 * FaqItem.astro — native <details>/<summary> accordion entry with a
 * plus/minus mark. JSON-LD on the page already covers structured data.
 */
interface Props {
  question: string;
  answer: string;
  id: string;
  class?: string;
}

const { question, answer, id, class: className = '' } = Astro.props;
---

<details id={id} class={['group border-t border-rule', className].filter(Boolean).join(' ')}>
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-lg font-bold text-ink [font-stretch:112%] [&::-webkit-details-marker]:hidden hover:text-accent-ink"
  >
    <span>{question}</span>
    <span class="relative mt-2 size-3 shrink-0" aria-hidden="true">
      <span class="absolute inset-x-0 top-1/2 h-[1.5px] -translate-y-1/2 bg-current"></span>
      <span class="absolute inset-y-0 left-1/2 w-[1.5px] -translate-x-1/2 bg-current transition-transform duration-150 group-open:scale-y-0"></span>
    </span>
  </summary>
  <p class="faq-answer max-w-[68ch] pb-6 leading-relaxed text-ink-2">{answer}</p>
</details>

<style>
  details[open] .faq-answer {
    animation: faq-open 0.35s var(--ease-out);
  }
  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
