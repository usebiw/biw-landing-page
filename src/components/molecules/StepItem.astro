---
/**
 * StepItem.astro — one step on the approval-flow timeline. On md+ the
 * timeline runs down the center and steps alternate sides (`side`); on
 * mobile every step sits to the right of a single left rail. The glowing
 * node on the rail is part of this component so the rail itself stays a
 * plain line in the parent.
 *
 * Status tokens written in the step copy (DRAFT, IN_REVIEW, APPROVED)
 * render as small blue pills — they are real states of the product, so
 * they read as states, not as prose.
 */
interface Props {
  index: number;
  label: string;
  stepLabel: string;
  side: 'left' | 'right';
  class?: string;
}

const { index, label, stepLabel, side, class: className = '' } = Astro.props;

// Split on product status tokens (ALL_CAPS words ≥ 5 chars), keeping them.
const parts = label.split(/\b([A-Z][A-Z_]{4,})\b/);
---

<li
  class:list={[
    'relative grid grid-cols-[2.5rem_1fr] gap-x-4 md:grid-cols-[1fr_3rem_1fr] md:gap-x-6',
    className,
  ]}
>
  <div class="relative col-start-1 row-start-1 flex justify-center md:col-start-2">
    <span class="step-node relative z-10 mt-5 flex size-10 items-center justify-center rounded-full border border-biw-400/50 bg-[var(--surface-canvas)] font-display text-sm font-bold tabular-nums text-biw-400">
      {index}
    </span>
  </div>

  <div
    data-spotlight
    class:list={[
      'glass-light glass-edge glass-interactive spotlight relative col-start-2 row-start-1 rounded-2xl p-5 md:p-6',
      side === 'left' ? 'md:col-start-1 md:text-right' : 'md:col-start-3',
    ]}
  >
    <p class="text-xs font-semibold uppercase tracking-[0.1em] text-biw-400">
      {stepLabel} {index}
    </p>
    <p class="mt-2 font-display text-base font-bold leading-snug tracking-tight text-[var(--text-primary)] md:text-lg">
      {parts.map((part, i) =>
        i % 2 === 1 ? (
          <span class="mx-0.5 inline-flex translate-y-[-1px] items-center rounded-md border border-biw-400/40 bg-biw-500/15 px-1.5 py-0.5 align-middle font-sans text-[0.7rem] font-bold uppercase tracking-[0.06em] text-biw-400">
            {part}
          </span>
        ) : (
          part
        ),
      )}
    </p>
  </div>
</li>

<style>
  .step-node {
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--surface-canvas) 80%, transparent),
      0 0 26px rgb(20 80 255 / 0.55);
  }
</style>
