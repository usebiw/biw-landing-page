---
/**
 * SectionHeader.astro — the one heading treatment every section intro
 * uses: gradient H2 (mist → electric blue, user-requested) with an
 * optional intro paragraph and an optional trailing slot (e.g. a
 * "Datos de ejemplo" badge). No eyebrow/kicker above it — banned.
 */
import Heading from '../atoms/Heading.astro';

interface Props {
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  level?: 2 | 3;
  class?: string;
}

const { title, intro, align = 'left', level = 2, class: className = '' } = Astro.props;
const centered = align === 'center';
---

<div class:list={['relative', centered && 'mx-auto flex max-w-3xl flex-col items-center text-center', className]}>
  <div class:list={['flex flex-wrap items-center gap-3', centered && 'justify-center']}>
    <Heading level={level} size="xl" gradient>{title}</Heading>
    <slot name="aside" />
  </div>
  {intro && (
    <p class:list={['mt-5 max-w-[62ch] text-base leading-relaxed text-[var(--text-secondary)] md:text-lg', centered && 'mx-auto']}>
      {intro}
    </p>
  )}
</div>
