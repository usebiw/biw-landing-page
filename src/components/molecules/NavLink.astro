---
/**
 * NavLink.astro — header/nav anchor with visible focus ring and an active
 * state (`data-active`, set by SiteHeader's scroll-spy, or `active` prop):
 * ink text with a 2px blue underline, like a marked section on a plan.
 */
interface Props {
  href: string;
  label: string;
  active?: boolean;
  class?: string;
}

const { href, label, active = false, class: className = '' } = Astro.props;
---

<a
  href={href}
  aria-current={active ? 'page' : undefined}
  data-active={active ? '' : undefined}
  class:list={[
    'nav-link relative px-1 py-1.5 font-sans text-sm text-ink-2 transition-colors duration-150 hover:text-ink data-[active]:text-ink',
    className,
  ]}
>
  {label}
</a>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover::after {
    scale: 0.4 1;
  }

  .nav-link[data-active]::after {
    scale: 1 1;
  }
</style>
