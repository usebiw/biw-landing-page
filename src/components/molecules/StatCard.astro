---
/**
 * StatCard.astro
 * Deliberately no icon, no card-shell chrome (craft-floor: refuse the
 * hero-metric template if repeated identically across 3+ sections —
 * vary size/weight per band via the `class` prop rather than wrapping
 * every value in the same bordered box).
 */
interface Props {
  value: string;
  label: string;
  class?: string;
}

const { value, label, class: className = '' } = Astro.props;
---

<div class={['flex flex-col gap-1', className].filter(Boolean).join(' ')}>
  <span class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">{value}</span>
  <span class="font-sans text-xs font-semibold uppercase tracking-[0.1em] text-[var(--text-secondary)]">{label}</span>
</div>
