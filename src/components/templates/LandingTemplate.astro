---
/**
 * LandingTemplate.astro — assembles every organism in scroll order inside
 * <main>. Sections are numbered like the sheets of a drawing set
 * (01 Comparison … 08 Contact); the number lives in each organism's
 * SectionHead, so keep it in step with this order.
 */
import SiteHeader from '../organisms/SiteHeader.astro';
import Hero from '../organisms/Hero.astro';
import SiteElevation from '../organisms/SiteElevation.astro';
import SurveyTape from '../organisms/SurveyTape.astro';
import Comparison from '../organisms/Comparison.astro';
import ModulesIndex from '../organisms/ModulesIndex.astro';
import CorteSection from '../organisms/CorteSection.astro';
import RolesTable from '../organisms/RolesTable.astro';
import Implementation from '../organisms/Implementation.astro';
import SecuritySection from '../organisms/SecuritySection.astro';
import Faq from '../organisms/Faq.astro';
import ContactSection from '../organisms/ContactSection.astro';
import SiteFooter from '../organisms/SiteFooter.astro';
---

<SiteHeader />

<main>
  <Hero />
  <SiteElevation />
  <Comparison />
  <SurveyTape />
  <ModulesIndex />
  <CorteSection />
  <RolesTable />
  <Implementation />
  <SecuritySection />
  <Faq />
  <ContactSection />
</main>

<SiteFooter />
