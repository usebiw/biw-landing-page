---
/**
 * RolesTable.astro — who does what in BIW, as a three-column ruled table
 * (role · what they do · what they see). Replaces the old card carousel:
 * a buyer compares roles across, which a table does and a carousel hides.
 */
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import SectionHead from '../molecules/SectionHead.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const roles = (await getCollection('roles', (e) => e.data.locale === locale)).sort((a, b) => a.data.order - b.data.order);
---

<section id="roles" class="bg-paper-2" aria-labelledby="roles-title">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
    <SectionHead id="roles-title" number="04" label={t('roles.label')} title={t('roles.heading')} intro={t('roles.intro')} />

    <table class="mt-14 w-full border-collapse text-left">
      <thead class="hidden md:table-header-group">
        <tr class="border-b border-rule text-xs font-semibold text-ink-3">
          <th scope="col" class="w-1/4 pb-3 pr-8">{t('roles.colRole')}</th>
          <th scope="col" class="w-5/12 pb-3 pr-8">{t('roles.colDoes')}</th>
          <th scope="col" class="pb-3">{t('roles.colSees')}</th>
        </tr>
      </thead>
      <tbody>
        {
          roles.map((role, i) => (
            <tr class="grid gap-2 border-b border-rule py-6 transition-colors duration-150 hover:bg-sheet/60 md:table-row md:py-0" data-reveal style={`--i:${i % 3}`}>
              <th scope="row" class="font-display text-lg font-bold text-ink [font-stretch:112%] md:py-6 md:pr-8 md:align-top">
                {role.data.name}
              </th>
              <td class="text-ink md:py-6 md:pr-8 md:align-top">{role.data.does}</td>
              <td class="text-ink-2 md:py-6 md:align-top">
                <span class="mr-1 text-xs font-semibold text-ink-3 md:hidden">{t('roles.colSees')}:</span>
                {role.data.sees}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
