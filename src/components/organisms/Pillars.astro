---
/**
 * Pillars.astro — 3 pillars (visibility, control, decision). Deliberately
 * NOT three identical cards: "Control de obra" runs as a large manifesto
 * block (BIW's core mechanism), the other two sit as secondary, smaller
 * entries beside it — avoiding the banned "hero-metric template" repeat.
 * More glassmorphism per the brief: the secondary cards now sit on
 * `.glass-light` (subtle, still theme-reactive) instead of a flat tint.
 */
import { getCollection } from 'astro:content';
import { type Locale } from '../../lib/i18n';
import Heading from '../atoms/Heading.astro';
import Icon from '../atoms/Icon.astro';
import Atmosphere from '../molecules/Atmosphere.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const pillars = await getCollection('pillars', (e) => e.data.locale === locale);
const control = pillars.find((p) => p.data.icon === 'control')!;
const secondary = pillars.filter((p) => p.data.icon !== 'control');

const iconMap: Record<string, 'eye' | 'shield' | 'chart'> = {
  visibility: 'eye',
  control: 'shield',
  decision: 'chart',
};
---

<section id="producto" class="relative isolate overflow-hidden">
  <Atmosphere variant="left" grid={false} />
  <div class="relative z-10 mx-auto grid max-w-7xl gap-6 px-6 py-24 md:py-32 lg:grid-cols-[1.3fr_1fr] lg:gap-8">
    <article
      data-spotlight
      class="glass-edge spotlight relative overflow-hidden rounded-3xl border border-white/10 bg-ink-900 p-8 text-mist-50 shadow-[0_40px_100px_-30px_rgba(20,80,255,0.55)] md:p-12"
    >
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(20,80,255,0.35),transparent_60%)]" aria-hidden="true"></div>
      <div class="dot-grid opacity-60 [--grid-dot:rgb(255_255_255/0.08)]" aria-hidden="true"></div>
      <div class="relative">
        <span class="inline-flex size-14 items-center justify-center rounded-2xl border border-biw-400/30 bg-biw-500/15 shadow-[0_0_30px_rgba(20,80,255,0.45)]">
          <Icon name={iconMap[control.data.icon]} class="size-7 text-biw-400" />
        </span>
        <Heading
          level={2}
          size="xl"
          class="mt-8 bg-[linear-gradient(100deg,#f4f6fa_0%,#c9d6ff_40%,#4d7bff_100%)] bg-clip-text pb-[0.08em] text-transparent"
        >
          {control.data.title}
        </Heading>
        <p class="mt-4 max-w-[52ch] text-lg leading-relaxed text-mist-100/65">
          {control.data.description}
        </p>
      </div>
    </article>

    <div class="flex flex-col gap-6 lg:gap-8">
      {secondary.map((pillar) => (
        <article data-spotlight class="glass-light glass-edge glass-interactive spotlight relative flex-1 rounded-3xl p-7 md:p-8">
          <span class="inline-flex size-11 items-center justify-center rounded-xl border border-[var(--border-hairline)] bg-biw-500/10">
            <Icon name={iconMap[pillar.data.icon]} class="size-5 text-biw-400" />
          </span>
          <Heading level={3} size="md" class="mt-4 text-[var(--text-primary)]">
            {pillar.data.title}
          </Heading>
          <p class="mt-3 max-w-[48ch] text-sm leading-relaxed text-[var(--text-secondary)]">
            {pillar.data.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
