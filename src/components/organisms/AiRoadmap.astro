---
/**
 * AiRoadmap.astro — roadmap entries. Every item carries a visible
 * StatusPill tone="neutral" reading "Próximamente"/"Coming soon" — never
 * implying the feature ships today. Signal orange (warning/blocked) stays
 * reserved for the budget instrument's 80%/110% gates, never used here.
 */
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import Heading from '../atoms/Heading.astro';
import SectionHeader from '../molecules/SectionHeader.astro';
import Atmosphere from '../molecules/Atmosphere.astro';
import type { IconName } from '../atoms/Icon.astro';
import StatusPill from '../atoms/StatusPill.astro';
import Icon from '../atoms/Icon.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const roadmap = (await getCollection('roadmap', (e) => e.data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
// One glyph per roadmap item, in content order (WhatsApp bot, delay
// prediction, Vision AI, narrative reports) — was a repeated gear.
const roadmapIcons: IconName[] = ['message-circle', 'trending-up', 'camera', 'file-text'];
---

<section class="relative isolate overflow-hidden">
  <Atmosphere variant="left" grid={false} />
  <div class="relative z-10 mx-auto max-w-6xl px-6 py-24 md:py-32">
  <SectionHeader title={t('roadmap.heading')} intro={t('roadmap.intro')} />

  <ol class="glass-light glass-edge relative mt-12 flex flex-col divide-y divide-dashed divide-[var(--border-hairline-strong)] rounded-3xl px-5 md:px-8">
    {roadmap.map((item, index) => (
      <li class="group flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:gap-6">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl border border-dashed border-[var(--border-hairline-strong)] bg-[var(--surface-card)] transition-colors duration-300 group-hover:border-biw-400/60">
          <Icon name={roadmapIcons[index] ?? 'settings'} class="size-5 text-[var(--text-secondary)] transition-colors duration-300 group-hover:text-biw-400" />
        </span>
        <div class="flex-1">
          <Heading level={3} size="md" class="text-[var(--text-primary)]">{item.data.name}</Heading>
          <p class="mt-1 max-w-[60ch] text-sm leading-relaxed text-[var(--text-secondary)]">
            {item.data.description}
          </p>
        </div>
        <StatusPill tone="neutral" class="shrink-0 self-start sm:self-center">{t('roadmap.comingSoon')}</StatusPill>
      </li>
    ))}
  </ol>
  </div>
</section>
