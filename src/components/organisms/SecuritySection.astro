---
/**
 * SecuritySection.astro — security in the buyer's words: own address per
 * company, role-scoped visibility, everything on record, protected
 * access. Two-column ruled list; no RLS/backend jargon on this surface.
 */
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import SectionHead from '../molecules/SectionHead.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const items = (await getCollection('security', (e) => e.data.locale === locale)).sort((a, b) => a.data.order - b.data.order);
---

<section id="seguridad" class="bg-paper-2" aria-labelledby="seguridad-title">
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
    <SectionHead id="seguridad-title" number="06" label={t('security.label')} title={t('security.heading')} />

    <dl class="mt-14 grid gap-x-8 md:grid-cols-12">
      {
        items.map((item, i) => (
          <div data-reveal style={`--i:${i % 2}`} class:list={['border-t border-rule py-7 md:col-span-4', i % 2 === 0 ? 'md:col-start-4' : 'md:col-start-8 md:col-span-5']}>
            <dt class="font-display text-lg font-bold text-ink [font-stretch:112%]">{item.data.title}</dt>
            <dd class="mt-2 leading-relaxed text-ink-2">{item.data.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
