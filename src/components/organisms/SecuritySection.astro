---
/**
 * SecuritySection.astro — asymmetric: a sticky glass "isolation" visual
 * (one company = one subdomain, data isolated by RLS; every action
 * crossing the 3 permission layers) beside the list of security entries
 * (multitenancy, 3-layer perms, auth hardening, Colombian holidays).
 * The subdomains in the visual are illustrative and labeled as samples;
 * the layer names mirror the permisos-3-capas content entry.
 */
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import Heading from '../atoms/Heading.astro';
import Icon from '../atoms/Icon.astro';
import Badge from '../atoms/Badge.astro';
import SectionHeader from '../molecules/SectionHeader.astro';
import Atmosphere from '../molecules/Atmosphere.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const security = (await getCollection('security', (e) => e.data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const iconFallback: Record<string, 'building' | 'layers' | 'shield' | 'calendar'> = {
  building: 'building',
  layers: 'layers',
  shield: 'shield',
  calendar: 'calendar',
};

const tenants = ['constructora-norte', 'obras-andinas', 'grupo-capital'];
const layers = [t('security.layerUi'), t('security.layerSeeds'), t('security.layerBackend')];
---

<section id="seguridad" class="relative isolate overflow-hidden">
  <Atmosphere variant="left" />

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-24 md:py-32">
    <SectionHeader title={t('security.heading')} intro={t('security.intro')} />

    <div class="mt-14 grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
      <div class="relative lg:sticky lg:top-28 lg:self-start">
        <div class="glow-sphere left-1/3 top-1/4 size-[24rem] opacity-60" aria-hidden="true"></div>

        <div data-spotlight class="glass-strong glass-edge spotlight relative rounded-3xl p-6 md:p-8">
          <div class="flex items-center justify-between gap-3">
            <p class="font-display text-base font-bold text-[var(--text-primary)]">{t('security.visualTitle')}</p>
            <Badge tone="blue">{t('security.sampleTenants')}</Badge>
          </div>

          <ul class="mt-6 flex flex-col gap-2.5">
            {tenants.map((tenant, i) => (
              <li
                class:list={[
                  'flex items-center gap-3 rounded-xl border px-4 py-3 transition-colors',
                  i === 0
                    ? 'border-biw-400/50 bg-biw-500/10 shadow-[0_0_30px_-6px_rgba(20,80,255,0.55)]'
                    : 'border-[var(--border-hairline)] bg-[var(--surface-card)]',
                ]}
              >
                <Icon name="lock" class:list={['size-4 shrink-0', i === 0 ? 'text-biw-400' : 'text-[var(--text-secondary)]']} />
                <span class="min-w-0 flex-1 truncate text-sm text-[var(--text-primary)]">
                  <span class="font-semibold">{tenant}</span><span class="text-[var(--text-secondary)]">.siteops.tech</span>
                </span>
                {i === 0 && (
                  <span class="hidden shrink-0 text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-biw-400 sm:inline">
                    {t('security.visualIsolated')}
                  </span>
                )}
              </li>
            ))}
          </ul>

          <div class="mt-8 border-t border-[var(--border-hairline)] pt-6">
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--text-secondary)]">
              {t('security.layersTitle')}
            </p>
            <div class="layer-stack mt-5 flex flex-col items-center gap-2">
              {layers.map((layer, i) => (
                <div
                  class="layer flex h-11 items-center justify-center rounded-xl border border-biw-400/35 text-xs font-semibold uppercase tracking-[0.1em] text-[var(--text-primary)]"
                  style={`width:${76 + i * 12}%;--i:${i}`}
                >
                  {layer}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col divide-y divide-[var(--border-hairline)]">
        {security.map((item, index) => (
          <article class="group flex gap-5 py-7 first:pt-0 last:pb-0">
            <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-xl border border-[var(--border-hairline)] bg-biw-500/10 transition-[box-shadow,border-color] duration-300 group-hover:border-biw-400/50 group-hover:shadow-[0_0_24px_rgba(20,80,255,0.45)]">
              <Icon name={iconFallback[item.data.icon] ?? 'shield'} class="size-5 text-biw-400" />
            </span>
            <div>
              <Heading level={3} size={index === 0 ? 'lg' : 'md'} class="text-[var(--text-primary)]">
                {item.data.title}
              </Heading>
              <p class="mt-2 max-w-[60ch] text-sm leading-relaxed text-[var(--text-secondary)]">
                {item.data.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .layer {
    background: linear-gradient(
      180deg,
      rgb(20 80 255 / calc(0.08 + var(--i) * 0.08)),
      rgb(20 80 255 / calc(0.03 + var(--i) * 0.05))
    );
    box-shadow: 0 10px 30px -16px rgb(20 80 255 / calc(0.4 + var(--i) * 0.2));
  }
</style>
