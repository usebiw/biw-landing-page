---
/**
 * Faq.astro — one FaqItem per faqs entry, ruled list under the section head.
 */
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import SectionHead from '../molecules/SectionHead.astro';
import FaqItem from '../molecules/FaqItem.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const faqs = (await getCollection('faqs', (e) => e.data.locale === locale)).sort((a, b) => a.data.order - b.data.order);
---

<section id="faqs" class="mx-auto max-w-7xl px-6 py-16 md:py-24" aria-labelledby="faqs-title">
  <SectionHead id="faqs-title" number="07" label={t('faqs.label')} title={t('faqs.heading')} />

  <div class="mt-10 md:grid md:grid-cols-12 md:gap-8">
    <div class="border-b border-rule md:col-span-9 md:col-start-4">
      {faqs.map((faq, i) => <div data-reveal style={`--i:${i % 3}`}><FaqItem question={faq.data.question} answer={faq.data.answer} id={faq.id} /></div>)}
    </div>
  </div>
</section>
