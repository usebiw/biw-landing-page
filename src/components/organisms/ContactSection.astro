---
/**
 * ContactSection.astro — closing section: the contact form (DemoCta
 * island) on a plain sheet, WhatsApp and the data-handling note beside it.
 */
import { getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath, type Locale } from '../../lib/i18n';
import { getWhatsappHref } from '../../lib/whatsapp';
import SectionHead from '../molecules/SectionHead.astro';
import Icon from '../atoms/Icon.astro';
import DemoCta from './DemoCta';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const site = await getEntry('site', `site-${locale}`);
const hero = await getEntry('hero', `hero-${locale}`);
const whatsappHref = getWhatsappHref(site!.data.whatsappNumber, site!.data.whatsappMessage);
const privacyHref = getLocalizedPath('/privacidad', locale);
---

<section id="contacto" class="scope-blue relative isolate overflow-hidden" aria-labelledby="contacto-title">
  <div class="drift-blob -left-32 top-10 size-[30rem] [--blob:rgb(255_255_255/0.16)]" aria-hidden="true"></div>
  <div class="drift-blob -right-24 bottom-0 size-[28rem] [--blob:rgb(0_20_120/0.45)] [animation-delay:-14s]" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
    <SectionHead id="contacto-title" number="08" label={t('contact.label')} title={t('contact.heading')} intro={t('contact.intro')} />

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="scope-paper sheet spotlight lift p-6 md:p-8 lg:col-span-6 lg:col-start-4" data-reveal data-spotlight>
        <DemoCta client:idle locale={locale} whatsappHref={whatsappHref} whatsappLabel={hero!.data.ctaWhatsapp} privacyHref={privacyHref} />
      </div>

      <div class="flex flex-col lg:col-span-3" data-reveal style="--i:2">
        <a href={whatsappHref} class="group border-t-2 border-rule-strong py-5">
          <p class="flex items-center gap-2 text-sm font-semibold text-ink">
            <Icon name="whatsapp" class="size-4 text-accent" />
            {t('contact.whatsappTitle')}
          </p>
          <p class="mt-1 flex items-center gap-2 text-sm text-ink-2 group-hover:text-ink">
            {t('contact.whatsappBody')}
            <Icon name="arrow-right" class="size-3.5 transition-transform duration-150 group-hover:translate-x-0.5" />
          </p>
        </a>
        <a href={privacyHref} class="group border-t border-rule py-5">
          <p class="flex items-center gap-2 text-sm font-semibold text-ink">
            <Icon name="lock" class="size-4 text-accent" />
            {t('contact.privacyTitle')}
          </p>
          <p class="mt-1 text-sm text-ink-2 group-hover:text-ink">{t('contact.privacyBody')}</p>
        </a>
      </div>
    </div>
  </div>
</section>
