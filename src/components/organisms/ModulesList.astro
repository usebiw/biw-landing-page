---
/**
 * ModulesList.astro — one ModuleRow per modules entry, ordered by `order`.
 */
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import SectionHeader from '../molecules/SectionHeader.astro';
import Atmosphere from '../molecules/Atmosphere.astro';
import ModuleRow from '../molecules/ModuleRow.astro';
import type { IconName } from '../atoms/Icon.astro';

// content's `icon` field is a free-form string (progress/budget/crew/
// reports); map it to a real glyph — without this every row silently
// fell back to Icon.astro's default (a checkmark) for every module.
const contentIconToGlyph: Record<string, IconName> = {
  progress: 'trending-up',
  budget: 'wallet',
  crew: 'users',
  reports: 'file-text',
};

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const modules = (await getCollection('modules', (e) => e.data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);

// signal orange (warning/blocked) is reserved for the budget instrument's
// 80%/110% gates — module shipping-state uses ok/info/neutral instead.
const statusToTone = {
  live: 'ok',
  beta: 'info',
  roadmap: 'neutral',
} as const;

const statusToLabel = {
  live: locale === 'en' ? 'Available' : 'Disponible',
  beta: 'Beta',
  roadmap: t('roadmap.comingSoon'),
} as const;
---

<section id="modulos" class="relative isolate overflow-hidden">
  <Atmosphere variant="right" grid={false} />
  <div class="relative z-10 mx-auto max-w-5xl px-6 py-24 md:py-32">
  <SectionHeader title={t('modules.heading')} intro={t('modules.intro')} align="center" />

  <div class="glass-light glass-edge relative mt-14 divide-y divide-[var(--border-hairline)] rounded-3xl px-5 md:px-8">
    {modules.map((mod, index) => (
      <ModuleRow
        name={mod.data.name}
        summary={mod.data.summary}
        detail={mod.data.detail}
        icon={contentIconToGlyph[mod.data.icon] ?? 'file-text'}
        status={statusToTone[mod.data.status]}
        statusLabel={statusToLabel[mod.data.status]}
        index={index + 1}
      />
    ))}
  </div>
  </div>
</section>
