---
/**
 * Hero.astro — plain statement of what BIW does, two CTAs, one line of
 * local specifics, and the budget-control sheet as the product proof.
 * Fills the first screen. Text settles in and the sheet's bars fill
 * (global.css motion); the site elevation follows as its own band.
 */
import { getEntry } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import { getWhatsappHref } from '../../lib/whatsapp';
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import BudgetSheet from './BudgetSheet.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const hero = await getEntry('hero', `hero-${locale}`);
const site = await getEntry('site', `site-${locale}`);
const whatsappHref = getWhatsappHref(site!.data.whatsappNumber, site!.data.whatsappMessage);
const { headline, subcopy, ctaPrimary, ctaWhatsapp, localNote } = hero!.data;
const t = useTranslations(locale);
---

<section id="top" class="hero spotlight relative isolate flex min-h-[calc(100svh-4rem)] flex-col justify-center overflow-hidden" data-spotlight data-reveal>
  <!-- Full-section backdrop: moving plan grid, orbits, drifting blobs,
       crop marks and a dimension line drawn across the sheet. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-grid absolute inset-0"></div>
    <div class="drift-blob -left-40 top-[8%] size-[34rem] [--blob:rgb(0_60_255/0.10)]"></div>
    <div class="drift-blob right-[4%] -top-32 size-[38rem] [animation-delay:-8s]"></div>
    <div class="drift-blob bottom-[-18rem] left-[38%] size-[40rem] [--blob:rgb(51_102_255/0.10)] [animation-delay:-16s]"></div>

    <div class="orbit left-[72%] size-[86rem] max-lg:left-1/2 max-sm:size-[44rem] [animation-duration:90s]">
      <span class="absolute -top-1 left-1/2 size-2 rounded-full bg-accent"></span>
    </div>
    <div class="orbit left-[72%] size-[60rem] border-solid opacity-80 [animation-direction:reverse] [animation-duration:60s] max-lg:left-1/2 max-sm:size-[32rem]">
      <span class="absolute -bottom-1 left-1/2 size-1.5 rounded-full bg-ink-3"></span>
      <span class="absolute left-[-4px] top-1/2 size-2 rounded-full bg-accent/60"></span>
    </div>
    <div class="orbit left-[72%] size-[38rem] opacity-70 [animation-duration:40s] max-lg:left-1/2 max-sm:size-[22rem]">
      <span class="absolute -right-1 top-1/2 size-1.5 rounded-full bg-accent"></span>
    </div>

    <!-- crop marks -->
    <span class="hero-mark left-6 top-6 border-l border-t"></span>
    <span class="hero-mark right-6 top-6 border-r border-t"></span>
    <span class="hero-mark bottom-6 left-6 border-b border-l"></span>
    <span class="hero-mark bottom-6 right-6 border-b border-r"></span>

    <!-- dimension line across the section -->
    <div class="absolute inset-x-6 bottom-12 hidden items-center gap-3 text-[0.6875rem] text-ink-3 md:flex">
      <span class="figures">K0+000</span>
      <span class="hero-dim relative h-px flex-1 bg-ink-3/60">
        <span class="absolute -top-1.5 left-0 h-3 w-px bg-ink-3"></span>
        <span class="absolute -top-1.5 left-1/4 h-2 w-px bg-ink-3"></span>
        <span class="absolute -top-1.5 left-1/2 h-3 w-px bg-ink-3"></span>
        <span class="absolute -top-1.5 left-3/4 h-2 w-px bg-ink-3"></span>
        <span class="absolute -top-1.5 right-0 h-3 w-px bg-ink-3"></span>
      </span>
      <span class="figures">K1+200</span>
    </div>
  </div>

  <div class="mx-auto grid w-full max-w-7xl gap-14 px-6 py-14 md:py-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6 lg:pt-6">
      <h1 data-reveal class="max-w-[17ch] text-[2.5rem] leading-[1.02] text-ink sm:text-[3.25rem] lg:text-[3.75rem] xl:text-[4.25rem]">
        {headline}
      </h1>
      <p data-reveal style="--i:1" class="mt-7 max-w-[54ch] text-lg leading-relaxed text-ink-2">{subcopy}</p>

      <div data-reveal style="--i:2" class="mt-9 flex flex-wrap gap-3">
        <Button variant="primary" size="lg" href="#contacto">
          {ctaPrimary}
          <Icon name="arrow-right" class="size-4 transition-transform duration-150 group-hover:translate-x-0.5" />
        </Button>
        <Button variant="secondary" size="lg" href={whatsappHref}>
          <Icon name="whatsapp" class="size-4" />
          {ctaWhatsapp}
        </Button>
      </div>

      <p data-reveal style="--i:3" class="mt-10 max-w-[54ch] border-l-2 border-accent pl-4 text-sm leading-relaxed text-ink-2">{localNote}</p>
    </div>

    <div class="relative min-w-0 lg:col-span-6">
      <BudgetSheet />

      <div class="pointer-events-none absolute -left-6 -top-5 z-10 hidden sm:block md:-left-10" aria-hidden="true">
        <span class="float-tag"><Icon name="bell" class="size-3.5 text-accent" />{t('hero.chipDelay')}</span>
      </div>
      <div class="pointer-events-none absolute -bottom-5 right-3 z-10 hidden sm:block md:-right-6" aria-hidden="true">
        <span class="float-tag [animation-delay:-3s]"><span class="size-1.5 rounded-full bg-signal"></span>{t('hero.chipBlock')}</span>
      </div>
      <div class="pointer-events-none absolute -top-5 right-6 z-10 hidden xl:block" aria-hidden="true">
        <span class="float-tag [animation-delay:-5s]"><Icon name="check" class="size-3.5 text-accent" />{t('hero.chipApprovals')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Plan grid over the whole hero: minor 24px, major 120px, panning
     slowly; fades toward the edges so it never fights the text. */
  .hero-grid {
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--rule) 45%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--rule) 45%, transparent) 1px, transparent 1px);
    background-size:
      120px 120px,
      120px 120px,
      24px 24px,
      24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 85% 80% at 60% 45%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 85% 80% at 60% 45%, #000 35%, transparent 100%);
    animation: grid-pan 60s linear infinite;
  }

  @keyframes grid-pan {
    to {
      background-position:
        120px 120px,
        120px 120px,
        120px 120px,
        120px 120px;
    }
  }

  .hero-mark {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: var(--ink-3);
  }

  /* The dimension line is drawn across the section on load. */
  :global(html[data-js]) .hero-dim {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s var(--ease-out) 0.4s;
  }

  :global(html[data-js]) .hero.is-in .hero-dim {
    transform: scaleX(1);
  }

  /* The hero itself is a reveal host only to arm its children; it never
     fades or moves as a block. */
  :global(html[data-js]) .hero[data-reveal] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid {
      animation: none;
    }
  }
</style>
