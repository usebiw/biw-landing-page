---
/**
 * SiteHeader.astro — sticky paper header with a hairline rule. Logo + nav
 * (site.json) + primary "Contáctenos" CTA + theme toggle + language switcher. No login button —
 * this landing has no customer-facing auth entry point. Mobile menu via
 * checkbox-hack (no JS). The only script here is the scroll-spy that
 * underlines the nav item for the section in view; it re-binds on every
 * `astro:page-load`.
 */
import { getEntry } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import Logo from '../atoms/Logo.astro';
import Button from '../atoms/Button.astro';
import ThemeToggle from '../atoms/ThemeToggle.astro';
import LanguageSwitcher from '../atoms/LanguageSwitcher.astro';
import NavLink from '../molecules/NavLink.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const site = await getEntry('site', `site-${locale}`);
const nav = site!.data.nav;
---

<header data-site-header class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur-sm transition-shadow duration-300 data-[scrolled]:shadow-[0_8px_24px_-18px_rgb(11_13_16/0.35)]">
  <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6">
    <!-- Must stay a direct sibling of the mobile panel below: the panel
         opens via `peer-checked:` (general sibling combinator). -->
    <input type="checkbox" id="menu-toggle" class="peer sr-only" aria-label={t('header.openMenu')} />
    <a href="#top" class="shrink-0" aria-label={t('header.logoHome')}>
      <Logo variant="mark" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label={t('header.mainNav')}>
      {nav.map((item) => <NavLink href={item.href} label={item.label} />)}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <LanguageSwitcher currentLocale={locale} ariaLabel={t('language.switch')} />
      <ThemeToggle labelLight={t('theme.toggleToLight')} labelDark={t('theme.toggleToDark')} />
      <Button variant="primary" href="#contacto">{t('header.cta')}</Button>
    </div>

    <div class="flex items-center gap-1 lg:hidden">
      <ThemeToggle labelLight={t('theme.toggleToLight')} labelDark={t('theme.toggleToDark')} />
      <label
        for="menu-toggle"
        class="inline-flex size-9 cursor-pointer flex-col items-center justify-center gap-[5px] text-ink [.peer:focus-visible~div_&]:outline-2 [.peer:focus-visible~div_&]:outline-offset-2 [.peer:focus-visible~div_&]:outline-accent"
        aria-label={t('header.openMenu')}
      >
        <span class="block h-[1.5px] w-5 bg-current transition-transform duration-200 [.peer:checked~div_&]:translate-y-[3.25px] [.peer:checked~div_&]:rotate-45"></span>
        <span class="block h-[1.5px] w-5 bg-current transition-transform duration-200 [.peer:checked~div_&]:-translate-y-[3.25px] [.peer:checked~div_&]:-rotate-45"></span>
      </label>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 top-full flex max-h-0 flex-col overflow-hidden border-rule bg-paper px-6 opacity-0 transition-all duration-200 peer-checked:pointer-events-auto peer-checked:max-h-[32rem] peer-checked:border-b peer-checked:py-4 peer-checked:opacity-100 lg:hidden"
    >
      {nav.map((item) => <NavLink href={item.href} label={item.label} class="border-b border-rule py-3 text-base last-of-type:border-b-0" />)}
      <div class="mt-3 flex items-center justify-between gap-4 pt-2">
        <LanguageSwitcher currentLocale={locale} ariaLabel={t('language.switch')} />
        <Button variant="primary" href="#contacto">{t('header.cta')}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  let controller: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    const headerEl = header;

    const onScroll = () => headerEl.toggleAttribute('data-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    onScroll();

    // Close the mobile menu after picking a destination.
    const toggle = headerEl.querySelector<HTMLInputElement>('#menu-toggle');
    headerEl.querySelectorAll('a[href^="#"]').forEach((a) =>
      a.addEventListener('click', () => toggle && (toggle.checked = false), { signal }),
    );

    // Scroll-spy: mark the nav link whose section crosses the upper third.
    const links = Array.from(headerEl.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'));
    const sections = links
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((el): el is HTMLElement => Boolean(el));
    if (!sections.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) =>
            link.toggleAttribute('data-active', link.hash === `#${entry.target.id}`),
          );
        });
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
    signal.addEventListener('abort', () => observer.disconnect());
  });
</script>
