---
/**
 * SiteHeader.astro — sticky glass header. Logo + nav (site.json) + primary
 * "Contáctanos" CTA + theme toggle + language switcher. No login button —
 * this landing has no customer-facing auth entry point. Mobile menu via
 * checkbox-hack (no JS). The only script here is the scroll-spy that
 * underlines the nav item for the section in view and deepens the glass
 * once the page scrolls; it re-binds on every `astro:page-load`.
 */
import { getEntry } from 'astro:content';
import { useTranslations, type Locale } from '../../lib/i18n';
import Logo from '../atoms/Logo.astro';
import Button from '../atoms/Button.astro';
import ThemeToggle from '../atoms/ThemeToggle.astro';
import LanguageSwitcher from '../atoms/LanguageSwitcher.astro';
import NavLink from '../molecules/NavLink.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const site = await getEntry('site', `site-${locale}`);
const nav = site!.data.nav;
---

<header data-site-header class="site-header sticky top-0 z-50">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-3">
    <!-- Must stay a direct sibling of the mobile panel below: the panel
         opens via `peer-checked:` (general sibling combinator). -->
    <input type="checkbox" id="menu-toggle" class="peer sr-only" aria-label={t('header.openMenu')} />
    <a href="#top" class="shrink-0" aria-label={t('header.logoHome')}>
      <Logo class="scale-90" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={t('header.mainNav')}>
      {nav.map((item) => <NavLink href={item.href} label={item.label} />)}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <LanguageSwitcher currentLocale={locale} ariaLabel={t('language.switch')} />
      <ThemeToggle labelLight={t('theme.toggleToLight')} labelDark={t('theme.toggleToDark')} />
      <Button variant="primary" href="#demo" size="md">{t('header.cta')}</Button>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <ThemeToggle labelLight={t('theme.toggleToLight')} labelDark={t('theme.toggleToDark')} />
      <label
        for="menu-toggle"
        class="group inline-flex size-10 cursor-pointer flex-col items-center justify-center gap-[5px] rounded-full border border-[var(--border-hairline)] text-[var(--text-primary)] [.peer:focus-visible~div_&]:outline-2 [.peer:focus-visible~div_&]:outline-offset-2 [.peer:focus-visible~div_&]:outline-biw-400"
        aria-label={t('header.openMenu')}
      >
        <span class="block h-px w-4 bg-current transition-transform duration-300 [.peer:checked~div_&]:translate-y-[3px] [.peer:checked~div_&]:rotate-45"></span>
        <span class="block h-px w-4 bg-current transition-transform duration-300 [.peer:checked~div_&]:-translate-y-[3px] [.peer:checked~div_&]:-rotate-45"></span>
      </label>
    </div>

    <div
      class="mobile-panel pointer-events-none absolute inset-x-3 top-[calc(100%+0.5rem)] flex max-h-0 flex-col gap-1 overflow-hidden rounded-2xl px-5 opacity-0 transition-all duration-300 peer-checked:pointer-events-auto peer-checked:max-h-[30rem] peer-checked:py-4 peer-checked:opacity-100 lg:hidden"
    >
      {nav.map((item) => <NavLink href={item.href} label={item.label} class="py-2.5 text-base" />)}
      <div class="mt-2 flex flex-col gap-3 border-t border-[var(--border-hairline)] pb-1 pt-4">
        <LanguageSwitcher currentLocale={locale} ariaLabel={t('language.switch')} class="self-start" />
        <Button variant="primary" href="#demo" size="md" class="w-full">{t('header.cta')}</Button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: color-mix(in srgb, var(--surface-canvas) 55%, transparent);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid var(--border-hairline);
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }

  /* Luminous hairline under the glass — blue at the center, fading out. */
  .site-header::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(77 123 255 / 0.55), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .site-header[data-scrolled] {
    background-color: color-mix(in srgb, var(--surface-canvas) 68%, transparent);
    backdrop-filter: blur(36px) saturate(190%);
    -webkit-backdrop-filter: blur(36px) saturate(190%);
    box-shadow: 0 18px 50px -24px rgb(20 80 255 / 0.35);
  }

  .site-header[data-scrolled]::after {
    opacity: 1;
  }

  /* A backdrop-filter nested inside the (already blurred) header can only
     sample the header itself, never the page behind it — so the dropdown
     carries its own near-opaque canvas instead of relying on blur. */
  .mobile-panel {
    background-color: color-mix(in srgb, var(--surface-canvas) 94%, transparent);
    border: 1px solid var(--glass-border-strong);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 30px 80px -20px rgb(20 80 255 / 0.45);
  }
</style>

<script>
  let controller: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    const headerEl = header;

    const onScroll = () => headerEl.toggleAttribute('data-scrolled', window.scrollY > 12);
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    onScroll();

    // Close the mobile menu after picking a destination.
    const toggle = headerEl.querySelector<HTMLInputElement>('#menu-toggle');
    headerEl.querySelectorAll('a[href^="#"]').forEach((a) =>
      a.addEventListener('click', () => toggle && (toggle.checked = false), { signal }),
    );

    // Scroll-spy: mark the nav link whose section crosses the upper third.
    const links = Array.from(headerEl.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]'));
    const sections = links
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((el): el is HTMLElement => Boolean(el));
    if (!sections.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) =>
            link.toggleAttribute('data-active', link.hash === `#${entry.target.id}`),
          );
        });
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
    signal.addEventListener('abort', () => observer.disconnect());
  });
</script>
