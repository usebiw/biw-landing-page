---
/**
 * SiteFooter.astro — heavy ink rule, brand + two link columns
 * (navigate / get in touch) and legal row with a back-to-top control.
 */
import { getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath, type Locale } from '../../lib/i18n';
import { getWhatsappHref } from '../../lib/whatsapp';
import Logo from '../atoms/Logo.astro';
import Icon from '../atoms/Icon.astro';

const locale = (Astro.currentLocale === 'en' ? 'en' : 'es') as Locale;
const t = useTranslations(locale);
const site = await getEntry('site', `site-${locale}`);
const nav = site!.data.nav;
const year = new Date().getFullYear();
const privacyHref = getLocalizedPath('/privacidad', locale);
const whatsappHref = getWhatsappHref(site!.data.whatsappNumber, site!.data.whatsappMessage);

const linkClass = 'text-sm text-ink-2 transition-colors duration-150 hover:text-ink';
const headingClass = 'text-sm font-semibold text-ink';
---

<footer class="border-t-2 border-rule-strong bg-paper">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 py-14 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink-2">{t('footer.tagline')}</p>
      </div>

      <nav aria-label={t('footer.siteLinks')} class="md:col-span-3 md:col-start-7">
        <p class={headingClass}>{t('footer.navigate')}</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          {nav.map((item) => (
            <li><a href={item.href} class={linkClass}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-3">
        <p class={headingClass}>{t('footer.connect')}</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          <li><a href="#contacto" class={linkClass}>{t('header.cta')}</a></li>
          <li><a href={whatsappHref} class={linkClass}>WhatsApp</a></li>
          <li><a href={privacyHref} class={linkClass}>{t('footer.privacyLink')}</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-rule py-6 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} BIW — Building Integrated Workflow. {t('footer.rights')}</p>
      <a href="#top" class="inline-flex items-center gap-1.5 text-ink-2 hover:text-ink">
        <Icon name="chevron-down" class="size-3.5 rotate-180" />
        {t('footer.backToTop')}
      </a>
    </div>
  </div>
</footer>
